{
  "name": "dsh-chat-tidy",
  "version": "0.1.0",
  "description": "Polished, compact chat typography and layout for the DeepSeek Harness Web UI",
  "license": "MIT",
  "author": "ChuanTianML",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChuanTianML/dsh-chat-tidy.git"
  },
  "homepage": "https://github.com/ChuanTianML/dsh-chat-tidy#readme",
  "bugs": {
    "url": "https://github.com/ChuanTianML/dsh-chat-tidy/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "chat",
    "markdown",
    "typography",
    "web-ui"
  ],
  "packageManager": "pnpm@11.7.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "README.zh.md",
    "DESIGN.md",
    "CHANGELOG.md",
    "VALIDATION.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "verify:build": "pnpm run build && git diff --exit-code -- lib",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run verify:build",
    "pack:check": "pnpm pack --dry-run --json"
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.19.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.30.0",
    "jsdom": "^26.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.0"
  }
}
